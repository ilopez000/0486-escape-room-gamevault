---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

interface Props {
  titol: string;
  hud?: boolean;
}
const { titol, hud = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Escape room de repàs de les sessions 1 a 5 del MP 0486 Accés a dades: entorn, Path i Files, fluxos, CSV i accés aleatori." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{titol} · GameVault · 0486</title>
  </head>
  <body>
    <div class="fons" aria-hidden="true">
      <div class="fons-graella"></div>
      <div class="fons-llum"></div>
    </div>

    {hud && (
      <header id="hud" class="hud">
        <a class="hud-marca" href={`${base}/`} title="Torna a la selecció de nivell">
          <span class="logo">◆</span> GAME<b>VAULT</b>
        </a>
        <div class="hud-bloc">
          <span class="hud-etiqueta">Jugador</span>
          <span class="hud-valor" data-hud="agent">—</span>
        </div>
        <div class="hud-bloc">
          <span class="hud-etiqueta">XP</span>
          <span class="hud-valor xp" data-hud="xp">0</span>
        </div>
        <div class="hud-bloc integritat">
          <span class="hud-etiqueta">Vida</span>
          <span class="barra"><span class="barra-ple" data-hud="barra"></span></span>
          <span class="hud-valor petit" data-hud="integritat">100%</span>
        </div>
        <div class="hud-bloc">
          <span class="hud-etiqueta">Cartutxos</span>
          <span class="fragments" data-hud="fragments"></span>
        </div>
        <button class="hud-so" type="button" data-hud="so" aria-pressed="true">♪ So</button>
      </header>
    )}

    <main class="contingut">
      <slot />
    </main>

    <footer class="peu">
      MP 0486 · Accés a dades · DAM2 · Repàs de les sessions 1 a 5 · Prat FP
    </footer>

    <script>
      import { iniciaHud } from '../scripts/hud';
      iniciaHud();
    </script>
  </body>
</html>
